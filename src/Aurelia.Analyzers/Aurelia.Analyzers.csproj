<Project Sdk="Microsoft.NET.Sdk">

  <!-- PERIMETER (ADR-0003). Build-time enforcement of ADR-0006 inside the
       core boundary; analyzers must target netstandard2.0 to load in the
       compiler. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
